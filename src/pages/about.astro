---
import Layout from '../layouts/Layout.astro';
import Panel from '../components/ui/Panel.astro';
import Button from '../components/ui/Button.astro';
import SpeechBubble from '../components/ui/SpeechBubble.astro';
import EffectText from '../components/ui/EffectText.astro';
import Phoenix from '../components/effects/Phoenix.astro';
---

<Layout title="About | Phoenix Comics & Collectibles">
  
  <!-- Hero -->
  <section class="pt-32 pb-20 md:pt-40 md:pb-32 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-[--color-ash] via-[--color-ash-light] to-[--color-ash]"></div>
    <div class="absolute inset-0 halftone opacity-20"></div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <EffectText variant="new" rotation={-5} class="mb-6 inline-block">Issue #2</EffectText>
      <h1 class="font-display text-5xl md:text-7xl text-[--color-paper] mb-6">
        ORIGIN <span class="text-fire">STORY</span>
      </h1>
      <p class="text-xl text-[--color-smoke-light] max-w-2xl mx-auto">
        Every hero has a beginning. This is ours.
      </p>
    </div>
  </section>

  <!-- Panel 1: Young Peter discovers comics -->
  <section class="py-16 md:py-24 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <Panel variant="tilt" class="p-8 md:p-12 order-2 md:order-1" data-animate>
          <div class="text-center md:text-left">
            <span class="font-comic text-[--color-ember] text-sm">PANEL 1</span>
            <h2 class="font-display text-3xl md:text-4xl text-[--color-paper] mt-2 mb-6">
              THE DISCOVERY
            </h2>
            <p class="text-[--color-smoke-light] text-lg leading-relaxed mb-4">
              Like many heroes, the journey began with a single moment of discovery. 
              For Peter Gong, it was the day he picked up his first comic book — 
              a portal to infinite worlds, infinite possibilities.
            </p>
            <p class="text-[--color-smoke-light] leading-relaxed">
              That spark ignited a lifelong passion that would eventually 
              become something much bigger than a hobby.
            </p>
          </div>
        </Panel>
        
        <div class="order-1 md:order-2 flex justify-center" data-animate style="animation-delay: 0.2s;">
          <div class="relative w-64 h-80">
            <!-- Stacked comic books illustration -->
            <div class="absolute inset-0 bg-[--color-ember] rounded-lg transform rotate-6 opacity-40"></div>
            <div class="absolute inset-0 bg-[--color-flame] rounded-lg transform rotate-3 opacity-60"></div>
            <div class="absolute inset-0 bg-[--color-heat] rounded-lg shadow-xl flex items-center justify-center">
              <span class="font-display text-8xl text-white/30">#1</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Panel 2: 30+ years of passion -->
  <section class="py-16 md:py-24 bg-[--color-ash-light] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="flex justify-center" data-animate>
          <!-- Timeline illustration -->
          <div class="relative">
            <div class="w-1 h-64 bg-gradient-to-b from-[--color-ember] via-[--color-flame] to-[--color-heat] rounded-full"></div>
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-4 h-4 bg-[--color-ember] rounded-full"></div>
            <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-4 h-4 bg-[--color-flame] rounded-full"></div>
            <div class="absolute top-2/3 left-1/2 -translate-x-1/2 w-4 h-4 bg-[--color-heat] rounded-full"></div>
            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-6 h-6 bg-[--color-paper] rounded-full flex items-center justify-center">
              <Phoenix size="sm" class="w-4 h-4" />
            </div>
            
            <!-- Year labels -->
            <span class="absolute top-0 left-8 font-display text-sm text-[--color-smoke-light]">1970s</span>
            <span class="absolute top-1/3 left-8 font-display text-sm text-[--color-smoke-light]">1980s</span>
            <span class="absolute top-2/3 left-8 font-display text-sm text-[--color-smoke-light]">1993</span>
            <span class="absolute bottom-0 left-8 font-display text-sm text-[--color-ember]">TODAY</span>
          </div>
        </div>
        
        <Panel variant="comic" class="p-8 md:p-12" data-animate style="animation-delay: 0.2s;">
          <span class="font-comic text-[--color-ember] text-sm">PANEL 2</span>
          <h2 class="font-display text-3xl md:text-4xl text-[--color-paper] mt-2 mb-6">
            30+ YEARS OF PASSION
          </h2>
          <p class="text-[--color-smoke-light] text-lg leading-relaxed mb-4">
            From collector to retailer, the journey spans over three decades. 
            I've been in comic book retail for thirty plus years, and I've been 
            an avid collector for even longer.
          </p>
          <p class="text-[--color-smoke-light] leading-relaxed">
            But I emphasize reading over collecting — that's why I like to 
            refer to myself as <strong class="text-[--color-flame]">"comic-sama"</strong>.
          </p>
        </Panel>
      </div>
    </div>
  </section>

  <!-- Panel 3: The Phoenix rises -->
  <section class="py-16 md:py-24 relative overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center opacity-5">
      <Phoenix size="xl" animated={false} class="w-[500px] h-[500px]" />
    </div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <Panel variant="broken" class="p-12 md:p-16" data-animate>
        <span class="font-comic text-[--color-ember] text-sm">PANEL 3</span>
        <h2 class="font-display text-4xl md:text-5xl text-[--color-paper] mt-2 mb-8">
          THE PHOENIX <span class="text-fire">RISES</span>
        </h2>
        <p class="text-xl text-[--color-smoke-light] leading-relaxed mb-6 max-w-2xl mx-auto">
          In 1993, Phoenix Comics & Collectibles opened its doors in Hicksville, 
          Long Island — a haven for those who share the passion for stories 
          that transport us to other worlds.
        </p>
        <p class="text-[--color-paper] text-lg">
          Rising from the ashes of ordinary retail, we created something special.
        </p>
      </Panel>
    </div>
  </section>

  <!-- Panel 4: The collection grows -->
  <section class="py-16 md:py-24 bg-[--color-ash-light]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="font-comic text-[--color-ember] text-sm">PANEL 4</span>
        <h2 class="font-display text-3xl md:text-4xl text-[--color-paper] mt-2">
          THE COLLECTION
        </h2>
      </div>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <Panel variant="tilt" class="p-6 text-center" data-animate>
          <div class="text-5xl font-display text-[--color-ember] mb-2">1000s</div>
          <div class="font-comic text-[--color-paper]">Comic Books</div>
          <p class="text-sm text-[--color-smoke-light] mt-2">From Golden Age to modern</p>
        </Panel>
        
        <Panel variant="tilt" class="p-6 text-center" data-animate style="animation-delay: 0.1s;">
          <div class="text-5xl font-display text-[--color-flame] mb-2">100s</div>
          <div class="font-comic text-[--color-paper]">Manga Titles</div>
          <p class="text-sm text-[--color-smoke-light] mt-2">Classic and current series</p>
        </Panel>
        
        <Panel variant="tilt" class="p-6 text-center" data-animate style="animation-delay: 0.2s;">
          <div class="text-5xl font-display text-[--color-heat] mb-2">1000s</div>
          <div class="font-comic text-[--color-paper]">Novels</div>
          <p class="text-sm text-[--color-smoke-light] mt-2">Sci-fi, fantasy & horror</p>
        </Panel>
        
        <Panel variant="tilt" class="p-6 text-center" data-animate style="animation-delay: 0.3s;">
          <div class="text-5xl font-display text-[--color-paper] mb-2">30+</div>
          <div class="font-comic text-[--color-paper]">Years</div>
          <p class="text-sm text-[--color-smoke-light] mt-2">Serving the community</p>
        </Panel>
      </div>
    </div>
  </section>

  <!-- Panel 5: Meet your guide -->
  <section class="py-16 md:py-24 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="order-2 md:order-1" data-animate>
          <span class="font-comic text-[--color-ember] text-sm">PANEL 5</span>
          <h2 class="font-display text-3xl md:text-4xl text-[--color-paper] mt-2 mb-6">
            MEET YOUR GUIDE
          </h2>
          
          <div class="space-y-6 text-[--color-smoke-light]">
            <p class="text-lg leading-relaxed">
              <strong class="text-[--color-flame]">Peter Gong</strong> — owner, curator, and fellow enthusiast. 
              My personal tastes vary from the esoteric to the popular.
            </p>
            
            <div>
              <h3 class="font-display text-lg text-[--color-paper] mb-3">FAVORITE READS:</h3>
              <ul class="grid grid-cols-2 gap-2 text-sm">
                <li class="flex items-center gap-2">
                  <span class="text-[--color-ember]">▸</span> Walking Dead
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-[--color-ember]">▸</span> Strangers in Paradise
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-[--color-ember]">▸</span> Usagi Yojimbo
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-[--color-ember]">▸</span> Ultimate Spiderman
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-[--color-ember]">▸</span> Fables
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-[--color-ember]">▸</span> And tons more...
                </li>
              </ul>
            </div>
            
            <p class="leading-relaxed">
              I'm also a serious anime and manga fan, going back to the 70s classic stuff 
              to some current series and movies. Genre films are a passion too.
            </p>
          </div>
        </div>
        
        <div class="order-1 md:order-2 flex justify-center" data-animate style="animation-delay: 0.2s;">
          <div class="relative">
            <SpeechBubble variant="speech" direction="left" class="max-w-sm">
              <p class="text-lg">
                "My store is friendly and laid back, offering a welcome mat to all 
                who embrace all facets of fandom."
              </p>
            </SpeechBubble>
            
            <!-- Avatar placeholder -->
            <div class="absolute -bottom-8 -right-4 w-24 h-24 bg-gradient-to-br from-[--color-ember] to-[--color-heat] rounded-full flex items-center justify-center shadow-xl">
              <span class="font-display text-4xl text-white">P</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-32 bg-[--color-ash-light]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-[--color-paper] mb-6">
        CONTINUE THE <span class="text-fire">STORY</span>
      </h2>
      <p class="text-[--color-smoke-light] text-xl mb-10 max-w-2xl mx-auto">
        Every visit writes a new chapter. Come be part of our story.
      </p>
      
      <div class="flex flex-wrap justify-center gap-4">
        <Button variant="flame" size="lg" href="/visit">
          Visit Us
        </Button>
        <Button variant="ember" size="lg" href="/contact">
          Get in Touch
        </Button>
      </div>
    </div>
  </section>

</Layout>

<style>
  .text-fire {
    background: linear-gradient(180deg, var(--color-flame) 0%, var(--color-ember) 50%, var(--color-heat) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  [data-animate] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s var(--ease-panel), transform 0.6s var(--ease-panel);
  }
  
  [data-animate].visible {
    opacity: 1;
    transform: translateY(0);
  }
  
  @media (prefers-reduced-motion: reduce) {
    [data-animate] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  const animatedElements = document.querySelectorAll('[data-animate]');
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  });
  
  animatedElements.forEach(el => observer.observe(el));
</script>
