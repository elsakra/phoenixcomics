---
import Layout from '../layouts/Layout.astro';
import Panel from '../components/ui/Panel.astro';
import Button from '../components/ui/Button.astro';
import EffectText from '../components/ui/EffectText.astro';
import Phoenix from '../components/effects/Phoenix.astro';
---

<Layout title="Services | Phoenix Comics & Collectibles">
  
  <!-- Hero -->
  <section class="pt-32 pb-12 md:pt-40 md:pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-[--color-ash] via-[--color-ash-light] to-[--color-ash]"></div>
    <div class="absolute inset-0 halftone opacity-20"></div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h1 class="font-display text-5xl md:text-7xl text-[--color-paper] mb-6">
        OUR <span class="text-fire">SERVICES</span>
      </h1>
      <p class="text-xl text-[--color-smoke-light] max-w-2xl mx-auto">
        More than just a comic shop. We're here to serve collectors, readers, and fans alike.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8">
        
        <!-- Pull List / Subscriptions -->
        <Panel variant="comic" class="p-8 md:p-10" data-animate>
          <div class="flex items-start gap-4 mb-6">
            <div class="w-16 h-16 rounded-full bg-[--color-ember]/20 flex items-center justify-center text-[--color-ember] flex-shrink-0">
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l4.59-4.58L18 11l-6 6z"/>
              </svg>
            </div>
            <div>
              <EffectText variant="hot" rotation={-3} class="mb-2 inline-block text-xs">Popular</EffectText>
              <h2 class="font-display text-2xl text-[--color-paper]">PULL LIST SERVICE</h2>
            </div>
          </div>
          
          <p class="text-[--color-smoke-light] mb-6 leading-relaxed">
            Never miss an issue of your favorite series! Subscribe to titles and we'll hold them for you 
            every week. No more hunting — your comics are waiting.
          </p>
          
          <ul class="space-y-3 mb-8">
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-ember]">✓</span>
              Reserve titles in advance
            </li>
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-ember]">✓</span>
              Guaranteed copies held for you
            </li>
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-ember]">✓</span>
              Easy to manage subscriptions
            </li>
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-ember]">✓</span>
              Works with PREVIEWSworld PULLBOX
            </li>
          </ul>
          
          <Button variant="ember" href="https://www.previewsworld.com/pullbox" target="_blank">
            Start Your Pull List
          </Button>
        </Panel>

        <!-- CGC Grading -->
        <Panel variant="comic" class="p-8 md:p-10" data-animate style="animation-delay: 0.1s;">
          <div class="flex items-start gap-4 mb-6">
            <div class="w-16 h-16 rounded-full bg-[--color-flame]/20 flex items-center justify-center text-[--color-flame] flex-shrink-0">
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
            </div>
            <div>
              <h2 class="font-display text-2xl text-[--color-paper]">CGC GRADING</h2>
            </div>
          </div>
          
          <p class="text-[--color-smoke-light] mb-6 leading-relaxed">
            Protect and certify your valuable comics with professional CGC grading. 
            We handle the submission process for you — just bring in your books!
          </p>
          
          <ul class="space-y-3 mb-8">
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-flame]">✓</span>
              Professional evaluation
            </li>
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-flame]">✓</span>
              We handle all paperwork
            </li>
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-flame]">✓</span>
              Secure shipping to CGC
            </li>
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-flame]">✓</span>
              Preserve your investment
            </li>
          </ul>
          
          <Button variant="ember" href="/contact">
            Inquire About Grading
          </Button>
        </Panel>

        <!-- Mail Order -->
        <Panel variant="comic" class="p-8 md:p-10" data-animate style="animation-delay: 0.2s;">
          <div class="flex items-start gap-4 mb-6">
            <div class="w-16 h-16 rounded-full bg-[--color-heat]/20 flex items-center justify-center text-[--color-heat] flex-shrink-0">
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
            </div>
            <div>
              <h2 class="font-display text-2xl text-[--color-paper]">MAIL ORDER</h2>
            </div>
          </div>
          
          <p class="text-[--color-smoke-light] mb-6 leading-relaxed">
            Can't make it to the store? We ship anywhere in the United States! 
            Contact us with your wishlist and we'll get your comics to you.
          </p>
          
          <ul class="space-y-3 mb-8">
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-heat]">✓</span>
              Ships anywhere in the USA
            </li>
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-heat]">✓</span>
              Secure packaging
            </li>
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-heat]">✓</span>
              Credit card or money order
            </li>
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-heat]">✓</span>
              Fast turnaround
            </li>
          </ul>
          
          <Button variant="ember" href="/contact">
            Request Mail Order
          </Button>
        </Panel>

        <!-- Gift Certificates -->
        <Panel variant="comic" class="p-8 md:p-10" data-animate style="animation-delay: 0.3s;">
          <div class="flex items-start gap-4 mb-6">
            <div class="w-16 h-16 rounded-full bg-[--color-paper]/20 flex items-center justify-center text-[--color-paper] flex-shrink-0">
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z"/>
              </svg>
            </div>
            <div>
              <h2 class="font-display text-2xl text-[--color-paper]">GIFT CERTIFICATES</h2>
            </div>
          </div>
          
          <p class="text-[--color-smoke-light] mb-6 leading-relaxed">
            The perfect gift for the comic fan in your life! Available in any amount, 
            redeemable for anything in the store.
          </p>
          
          <ul class="space-y-3 mb-8">
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-paper]">✓</span>
              Any denomination
            </li>
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-paper]">✓</span>
              Never expires
            </li>
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-paper]">✓</span>
              Good for all merchandise
            </li>
            <li class="flex items-center gap-3 text-[--color-paper]">
              <span class="text-[--color-paper]">✓</span>
              Great for birthdays & holidays
            </li>
          </ul>
          
          <Button variant="ember" href="/visit">
            Get One In-Store
          </Button>
        </Panel>
      </div>
    </div>
  </section>

  <!-- Membership Section -->
  <section class="py-16 md:py-24 bg-[--color-ash-light]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <Phoenix size="lg" class="mx-auto mb-8" />
      <h2 class="font-display text-3xl md:text-4xl text-[--color-paper] mb-6">
        IN-STORE <span class="text-fire">MEMBERSHIP</span>
      </h2>
      <p class="text-[--color-smoke-light] text-lg mb-8 max-w-2xl mx-auto">
        Ask about our in-store membership program for exclusive benefits and discounts!
        Join the Phoenix family and get rewarded for your passion.
      </p>
      <Button variant="flame" size="lg" href="/contact">
        Learn More
      </Button>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl md:text-4xl text-[--color-paper] mb-6">
        QUESTIONS?
      </h2>
      <p class="text-[--color-smoke-light] text-lg mb-8">
        We're happy to help with any questions about our services.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button variant="ember" href="/contact">
          Contact Us
        </Button>
        <Button variant="ghost" href="/visit">
          Visit the Store
        </Button>
      </div>
    </div>
  </section>

</Layout>

<style>
  .text-fire {
    background: linear-gradient(180deg, var(--color-flame) 0%, var(--color-ember) 50%, var(--color-heat) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  [data-animate] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s var(--ease-panel), transform 0.6s var(--ease-panel);
  }
  
  [data-animate].visible {
    opacity: 1;
    transform: translateY(0);
  }
  
  @media (prefers-reduced-motion: reduce) {
    [data-animate] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  const animatedElements = document.querySelectorAll('[data-animate]');
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  });
  
  animatedElements.forEach(el => observer.observe(el));
</script>
