<style>
  /* Hero panel styles */
  .hero-panel {
    background: linear-gradient(180deg, var(--color-ash) 0%, #0a0a0a 100%);
  }
  
  .hero-phoenix {
    animation: hero-entrance 1s var(--ease-panel) forwards;
    opacity: 0;
    transform: translateY(30px) scale(0.9);
  }
  
  @keyframes hero-entrance {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  
  /* Background flames */
  .flame-bg {
    position: absolute;
    width: 300px;
    height: 400px;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    filter: blur(80px);
    opacity: 0.15;
    animation: flame-float 8s ease-in-out infinite;
  }
  
  .flame-1 {
    background: var(--color-ember);
    left: 10%;
    top: 20%;
    animation-delay: 0s;
  }
  
  .flame-2 {
    background: var(--color-flame);
    right: 15%;
    top: 30%;
    animation-delay: -2s;
  }
  
  .flame-3 {
    background: var(--color-heat);
    left: 50%;
    bottom: 20%;
    animation-delay: -4s;
  }
  
  @keyframes flame-float {
    0%, 100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-30px) scale(1.1);
    }
  }
  
  /* Thought bubble large */
  .thought-bubble-large {
    background: var(--color-paper);
    border-radius: 2rem;
    border: 4px solid #000;
    position: relative;
  }
  
  .thought-bubble-large::before,
  .thought-bubble-large::after {
    content: '';
    position: absolute;
    background: var(--color-paper);
    border: 3px solid #000;
    border-radius: 50%;
  }
  
  .thought-bubble-large::before {
    width: 24px;
    height: 24px;
    bottom: -18px;
    left: 40px;
  }
  
  .thought-bubble-large::after {
    width: 14px;
    height: 14px;
    bottom: -35px;
    left: 28px;
  }
  
  /* Comic carousel */
  .comic-carousel {
    scrollbar-width: thin;
    scrollbar-color: var(--color-ember) var(--color-ash-light);
  }
  
  .comic-carousel::-webkit-scrollbar {
    height: 8px;
  }
  
  .comic-carousel::-webkit-scrollbar-track {
    background: var(--color-ash-light);
    border-radius: 4px;
  }
  
  .comic-carousel::-webkit-scrollbar-thumb {
    background: var(--color-ember);
    border-radius: 4px;
  }
  
  /* Service cards stagger animation */
  .service-card {
    opacity: 0;
    transform: translateY(30px) rotate(-2deg);
    animation: card-entrance 0.6s var(--ease-panel) forwards;
  }
  
  .service-card:nth-child(2) { animation-delay: 0.1s; }
  .service-card:nth-child(3) { animation-delay: 0.2s; }
  .service-card:nth-child(4) { animation-delay: 0.3s; }
  
  @keyframes card-entrance {
    to {
      opacity: 1;
      transform: translateY(0) rotate(0);
    }
  }
  
  /* Animate elements on scroll */
  [data-animate] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s var(--ease-panel), transform 0.6s var(--ease-panel);
  }
  
  [data-animate].visible {
    opacity: 1;
    transform: translateY(0);
  }
  
  /* Fire text gradient */
  .text-fire {
    background: linear-gradient(180deg, var(--color-flame) 0%, var(--color-ember) 50%, var(--color-heat) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .flame-bg,
    .hero-phoenix,
    .service-card,
    [data-animate] {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  // Intersection Observer for scroll animations
  const animatedElements = document.querySelectorAll('[data-animate]');
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  });
  
  animatedElements.forEach(el => observer.observe(el));
</script>
