---
import Layout from '../layouts/Layout.astro';
import Panel from '../components/ui/Panel.astro';
import Button from '../components/ui/Button.astro';
import SpeechBubble from '../components/ui/SpeechBubble.astro';
import EffectText from '../components/ui/EffectText.astro';
import Phoenix from '../components/effects/Phoenix.astro';
---

<Layout title="Phoenix Comics & Collectibles | Long Island's Premier Comic Shop">
  
  <!-- ==================== PANEL 1: HERO SPLASH PAGE ==================== -->
  <section id="hero" class="hero-panel panel-viewport relative overflow-hidden">
    <!-- Background with halftone -->
    <div class="absolute inset-0 bg-gradient-to-b from-[--color-ash] via-[--color-ash-light] to-[--color-ash]"></div>
    <div class="absolute inset-0 halftone opacity-30"></div>
    
    <!-- Animated background flames -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="flame-bg flame-1"></div>
      <div class="flame-bg flame-2"></div>
      <div class="flame-bg flame-3"></div>
    </div>
    
    <!-- Content -->
    <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-4 text-center">
      <!-- Phoenix Animation -->
      <div class="hero-phoenix mb-8">
        <Phoenix size="xl" animated={true} />
      </div>
      
      <!-- Title - burns in -->
      <h1 class="hero-title font-display text-5xl md:text-7xl lg:text-8xl tracking-wider mb-6">
        <span class="block text-fire animate-burn-in" style="animation-delay: 0.2s;">PHOENIX</span>
        <span class="block text-[--color-paper] animate-burn-in" style="animation-delay: 0.4s;">COMICS</span>
        <span class="block text-[--color-smoke-light] text-2xl md:text-3xl tracking-widest animate-burn-in" style="animation-delay: 0.6s;">& COLLECTIBLES</span>
      </h1>
      
      <!-- Tagline in speech bubble -->
      <div class="animate-burn-in max-w-2xl" style="animation-delay: 0.8s;">
        <SpeechBubble variant="speech" direction="bottom" class="text-lg md:text-xl">
          Your Long Island haven for comics, manga, sci-fi, horror novels, and collectibles!
        </SpeechBubble>
      </div>
      
      <!-- CTA Buttons -->
      <div class="flex flex-wrap gap-4 mt-12 animate-burn-in" style="animation-delay: 1s;">
        <Button variant="flame" size="lg" href="/visit">
          Visit the Lair
        </Button>
        <Button variant="ember" size="lg" href="/about">
          Our Story
        </Button>
      </div>
      
      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-float">
        <div class="flex flex-col items-center gap-2 text-[--color-smoke-light]">
          <span class="text-sm font-display tracking-widest">SCROLL</span>
          <svg class="w-6 h-6 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PANEL 2: ORIGIN STORY ==================== -->
  <section id="origin" class="py-20 md:py-32 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
        
        <!-- Left: Vintage aesthetic panel -->
        <Panel variant="tilt" class="p-8 md:p-12 origin-story-panel" data-animate>
          <div class="relative">
            <EffectText variant="new" rotation={-8} class="absolute -top-4 -left-4">
              Est. 1993
            </EffectText>
            <h2 class="font-display text-4xl md:text-5xl text-[--color-ember] mt-6 mb-6">
              30+ YEARS OF PASSION
            </h2>
            <p class="text-[--color-paper] text-lg leading-relaxed mb-6">
              My name is <strong class="text-[--color-flame]">Peter Gong</strong>. I've been in comic book retail for over thirty years, 
              but I've been a collector even longer. I like to refer to myself as "comic-sama."
            </p>
            <p class="text-[--color-smoke-light] leading-relaxed">
              My personal tastes vary from the esoteric to the popular. From <em>Walking Dead</em> to 
              <em>Usagi Yojimbo</em>, from classic 70s anime to the latest releases.
            </p>
          </div>
        </Panel>
        
        <!-- Right: Modern quote panel -->
        <div class="relative" data-animate style="animation-delay: 0.2s;">
          <div class="thought-bubble-large p-8 md:p-12">
            <blockquote class="text-xl md:text-2xl text-[--color-ash] font-comic leading-relaxed">
              "My store is friendly and laid back, offering a welcome mat to all who embrace all facets of fandom."
            </blockquote>
            <cite class="block mt-6 text-[--color-smoke] text-sm">
              — Peter Gong, Owner
            </cite>
          </div>
          
          <!-- Decorative comics in background -->
          <div class="absolute -z-10 -right-4 -bottom-4 w-32 h-40 bg-[--color-ember] rounded opacity-20 transform rotate-6"></div>
          <div class="absolute -z-10 -right-8 -bottom-8 w-32 h-40 bg-[--color-flame] rounded opacity-10 transform rotate-12"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PANEL 3: SERVICES GRID ==================== -->
  <section id="services" class="py-20 md:py-32 bg-[--color-ash-light] relative overflow-hidden">
    <!-- Diagonal lines background -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background: repeating-linear-gradient(45deg, transparent, transparent 10px, var(--color-ember) 10px, var(--color-ember) 11px);"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16">
        <h2 class="font-display text-4xl md:text-6xl text-[--color-paper] mb-4">
          WHAT <span class="text-[--color-ember]">AWAITS</span>
        </h2>
        <p class="text-[--color-smoke-light] text-lg max-w-2xl mx-auto">
          More than just a store — a sanctuary for collectors, readers, and dreamers.
        </p>
      </div>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Service Card 1 -->
        <div class="service-card group" data-animate>
          <Panel variant="comic" class="h-full p-6 text-center transition-all duration-300 group-hover:bg-[--color-ash-lighter]">
            <div class="w-16 h-16 mx-auto mb-4 flex items-center justify-center text-[--color-ember] group-hover:scale-110 transition-transform">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M21 4H3a2 2 0 00-2 2v12a2 2 0 002 2h18a2 2 0 002-2V6a2 2 0 00-2-2zm-9 12H6v-2h6v2zm0-4H6v-2h6v2zm0-4H6V6h6v2zm6 8h-4V6h4v10z"/>
              </svg>
            </div>
            <h3 class="font-display text-xl text-[--color-paper] mb-2">NEW COMICS</h3>
            <p class="text-[--color-smoke-light] text-sm">Fresh releases every Wednesday. Never miss an issue.</p>
          </Panel>
        </div>
        
        <!-- Service Card 2 -->
        <div class="service-card group" data-animate style="animation-delay: 0.1s;">
          <Panel variant="comic" class="h-full p-6 text-center transition-all duration-300 group-hover:bg-[--color-ash-lighter]">
            <div class="w-16 h-16 mx-auto mb-4 flex items-center justify-center text-[--color-flame] group-hover:scale-110 transition-transform">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l4.59-4.58L18 11l-6 6z"/>
              </svg>
            </div>
            <h3 class="font-display text-xl text-[--color-paper] mb-2">PULL LIST</h3>
            <p class="text-[--color-smoke-light] text-sm">Subscribe to your favorites. We'll hold them for you.</p>
          </Panel>
        </div>
        
        <!-- Service Card 3 -->
        <div class="service-card group" data-animate style="animation-delay: 0.2s;">
          <Panel variant="comic" class="h-full p-6 text-center transition-all duration-300 group-hover:bg-[--color-ash-lighter]">
            <div class="w-16 h-16 mx-auto mb-4 flex items-center justify-center text-[--color-heat] group-hover:scale-110 transition-transform">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
            </div>
            <h3 class="font-display text-xl text-[--color-paper] mb-2">CGC GRADING</h3>
            <p class="text-[--color-smoke-light] text-sm">Professional grading service. Preserve your treasures.</p>
          </Panel>
        </div>
        
        <!-- Service Card 4 -->
        <div class="service-card group" data-animate style="animation-delay: 0.3s;">
          <Panel variant="comic" class="h-full p-6 text-center transition-all duration-300 group-hover:bg-[--color-ash-lighter]">
            <div class="w-16 h-16 mx-auto mb-4 flex items-center justify-center text-[--color-paper] group-hover:scale-110 transition-transform">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
              </svg>
            </div>
            <h3 class="font-display text-xl text-[--color-paper] mb-2">GIFT CARDS</h3>
            <p class="text-[--color-smoke-light] text-sm">The perfect gift for the collector in your life.</p>
          </Panel>
        </div>
      </div>
      
      <div class="text-center mt-12">
        <Button variant="ember" href="/services">
          All Services
        </Button>
      </div>
    </div>
  </section>

  <!-- ==================== PANEL 4: NEW RELEASES CAROUSEL ==================== -->
  <section id="new-releases" class="py-20 md:py-32 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-12">
        <div>
          <EffectText variant="hot" rotation={-3} class="mb-4 inline-block">This Week</EffectText>
          <h2 class="font-display text-4xl md:text-5xl text-[--color-paper]">
            NEW <span class="text-[--color-ember]">ARRIVALS</span>
          </h2>
        </div>
        <Button variant="ghost" href="https://www.previewsworld.com/NewReleases" class="hidden md:flex">
          View All
        </Button>
      </div>
      
      <!-- Comic covers carousel -->
      <div class="comic-carousel overflow-x-auto pb-4 -mx-4 px-4">
        <div class="flex gap-6 min-w-max">
          <!-- Comic Card 1 -->
          <a href="https://www.previewsworld.com/NewReleases" target="_blank" rel="noopener" class="comic-card w-48 group block" data-animate>
            <div class="relative aspect-[2/3] bg-[--color-ash-lighter] rounded-lg overflow-hidden border-4 border-black shadow-lg transition-all duration-300 group-hover:scale-105 group-hover:rotate-2 group-hover:shadow-2xl">
              <div class="absolute inset-0 bg-gradient-to-br from-[--color-ember] to-[--color-heat]"></div>
              <!-- Comic cover SVG graphic -->
              <svg class="absolute inset-0 w-full h-full" viewBox="0 0 120 180" preserveAspectRatio="xMidYMid slice">
                <rect x="10" y="10" width="100" height="25" fill="rgba(255,255,255,0.9)" rx="2"/>
                <text x="60" y="28" text-anchor="middle" font-family="var(--font-display)" font-size="14" fill="#e63946">AMAZING</text>
                <circle cx="60" cy="100" r="35" fill="rgba(0,0,0,0.3)"/>
                <text x="60" y="108" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="rgba(255,255,255,0.8)">#1</text>
                <rect x="15" y="150" width="90" height="20" fill="rgba(0,0,0,0.5)" rx="2"/>
                <text x="60" y="164" text-anchor="middle" font-family="var(--font-comic)" font-size="10" fill="white">SPIDER-MAN</text>
              </svg>
              <!-- Hover overlay -->
              <div class="absolute inset-0 bg-black/80 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-4">
                <div class="text-center">
                  <p class="font-display text-sm text-[--color-ember]">MARVEL</p>
                  <p class="font-comic text-white text-sm">Amazing Spider-Man</p>
                  <p class="font-display text-xs text-[--color-smoke-light] mt-2">Click to view releases</p>
                </div>
              </div>
            </div>
            <p class="mt-3 font-comic text-sm text-[--color-paper] text-center truncate">Amazing Spider-Man</p>
          </a>
          
          <!-- Comic Card 2 -->
          <a href="https://www.previewsworld.com/NewReleases" target="_blank" rel="noopener" class="comic-card w-48 group block" data-animate style="animation-delay: 0.1s;">
            <div class="relative aspect-[2/3] bg-[--color-ash-lighter] rounded-lg overflow-hidden border-4 border-black shadow-lg transition-all duration-300 group-hover:scale-105 group-hover:-rotate-2 group-hover:shadow-2xl">
              <div class="absolute inset-0 bg-gradient-to-br from-[--color-flame] to-[--color-ember]"></div>
              <svg class="absolute inset-0 w-full h-full" viewBox="0 0 120 180" preserveAspectRatio="xMidYMid slice">
                <rect x="10" y="10" width="100" height="25" fill="rgba(0,0,0,0.8)" rx="2"/>
                <text x="60" y="28" text-anchor="middle" font-family="var(--font-display)" font-size="16" fill="#f7c331">BATMAN</text>
                <path d="M60 70 L40 100 L50 100 L45 130 L75 130 L70 100 L80 100 Z" fill="rgba(0,0,0,0.4)"/>
                <text x="60" y="160" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="rgba(255,255,255,0.6)">#42</text>
              </svg>
              <div class="absolute inset-0 bg-black/80 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-4">
                <div class="text-center">
                  <p class="font-display text-sm text-[--color-flame]">DC</p>
                  <p class="font-comic text-white text-sm">Batman</p>
                  <p class="font-display text-xs text-[--color-smoke-light] mt-2">Click to view releases</p>
                </div>
              </div>
            </div>
            <p class="mt-3 font-comic text-sm text-[--color-paper] text-center truncate">Batman</p>
          </a>
          
          <!-- Comic Card 3 -->
          <a href="https://www.previewsworld.com/NewReleases" target="_blank" rel="noopener" class="comic-card w-48 group block" data-animate style="animation-delay: 0.2s;">
            <div class="relative aspect-[2/3] bg-[--color-ash-lighter] rounded-lg overflow-hidden border-4 border-black shadow-lg transition-all duration-300 group-hover:scale-105 group-hover:rotate-2 group-hover:shadow-2xl">
              <div class="absolute inset-0 bg-gradient-to-br from-[--color-heat] to-[--color-ash]"></div>
              <svg class="absolute inset-0 w-full h-full" viewBox="0 0 120 180" preserveAspectRatio="xMidYMid slice">
                <rect x="10" y="10" width="100" height="25" fill="rgba(255,255,255,0.9)" rx="2"/>
                <text x="60" y="28" text-anchor="middle" font-family="var(--font-display)" font-size="16" fill="#e63946">SPAWN</text>
                <ellipse cx="60" cy="95" rx="30" ry="40" fill="rgba(0,0,0,0.3)"/>
                <text x="60" y="100" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="rgba(255,255,255,0.7)">#7</text>
                <rect x="20" y="145" width="80" height="3" fill="rgba(255,255,255,0.3)"/>
                <rect x="25" y="152" width="70" height="3" fill="rgba(255,255,255,0.2)"/>
              </svg>
              <div class="absolute inset-0 bg-black/80 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-4">
                <div class="text-center">
                  <p class="font-display text-sm text-[--color-heat]">IMAGE</p>
                  <p class="font-comic text-white text-sm">Spawn</p>
                  <p class="font-display text-xs text-[--color-smoke-light] mt-2">Click to view releases</p>
                </div>
              </div>
            </div>
            <p class="mt-3 font-comic text-sm text-[--color-paper] text-center truncate">Spawn</p>
          </a>
          
          <!-- Comic Card 4 -->
          <a href="https://www.previewsworld.com/NewReleases" target="_blank" rel="noopener" class="comic-card w-48 group block" data-animate style="animation-delay: 0.3s;">
            <div class="relative aspect-[2/3] bg-[--color-ash-lighter] rounded-lg overflow-hidden border-4 border-black shadow-lg transition-all duration-300 group-hover:scale-105 group-hover:-rotate-2 group-hover:shadow-2xl">
              <div class="absolute inset-0 bg-gradient-to-br from-purple-600 to-purple-900"></div>
              <svg class="absolute inset-0 w-full h-full" viewBox="0 0 120 180" preserveAspectRatio="xMidYMid slice">
                <rect x="10" y="10" width="100" height="25" fill="rgba(255,255,255,0.9)" rx="2"/>
                <text x="60" y="28" text-anchor="middle" font-family="var(--font-display)" font-size="18" fill="#7c3aed">SAGA</text>
                <circle cx="40" cy="90" r="20" fill="rgba(255,255,255,0.2)"/>
                <circle cx="80" cy="100" r="15" fill="rgba(255,255,255,0.15)"/>
                <text x="60" y="150" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="rgba(255,255,255,0.5)">#1</text>
              </svg>
              <div class="absolute inset-0 bg-black/80 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-4">
                <div class="text-center">
                  <p class="font-display text-sm text-purple-400">INDIE</p>
                  <p class="font-comic text-white text-sm">Saga</p>
                  <p class="font-display text-xs text-[--color-smoke-light] mt-2">Click to view releases</p>
                </div>
              </div>
            </div>
            <p class="mt-3 font-comic text-sm text-[--color-paper] text-center truncate">Saga</p>
          </a>
          
          <!-- Comic Card 5 -->
          <a href="https://www.previewsworld.com/NewReleases" target="_blank" rel="noopener" class="comic-card w-48 group block" data-animate style="animation-delay: 0.4s;">
            <div class="relative aspect-[2/3] bg-[--color-ash-lighter] rounded-lg overflow-hidden border-4 border-black shadow-lg transition-all duration-300 group-hover:scale-105 group-hover:rotate-2 group-hover:shadow-2xl">
              <div class="absolute inset-0 bg-gradient-to-br from-green-600 to-green-900"></div>
              <svg class="absolute inset-0 w-full h-full" viewBox="0 0 120 180" preserveAspectRatio="xMidYMid slice">
                <rect x="10" y="10" width="100" height="30" fill="rgba(0,0,0,0.6)" rx="2"/>
                <text x="60" y="32" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="#22c55e">HULK</text>
                <ellipse cx="60" cy="100" rx="40" ry="35" fill="rgba(0,0,0,0.3)"/>
                <text x="60" y="108" text-anchor="middle" font-family="var(--font-display)" font-size="18" fill="rgba(255,255,255,0.6)">#15</text>
                <text x="60" y="160" text-anchor="middle" font-family="var(--font-comic)" font-size="10" fill="rgba(255,255,255,0.4)">SMASH!</text>
              </svg>
              <div class="absolute inset-0 bg-black/80 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-4">
                <div class="text-center">
                  <p class="font-display text-sm text-green-400">MARVEL</p>
                  <p class="font-comic text-white text-sm">Hulk</p>
                  <p class="font-display text-xs text-[--color-smoke-light] mt-2">Click to view releases</p>
                </div>
              </div>
            </div>
            <p class="mt-3 font-comic text-sm text-[--color-paper] text-center truncate">Hulk</p>
          </a>
          
          <!-- More comics indicator -->
          <div class="w-48 flex items-center justify-center">
            <a href="https://www.previewsworld.com/NewReleases" target="_blank" rel="noopener" class="text-center group">
              <div class="w-20 h-20 rounded-full border-2 border-dashed border-[--color-smoke] flex items-center justify-center group-hover:border-[--color-ember] transition-colors">
                <svg class="w-8 h-8 text-[--color-smoke] group-hover:text-[--color-ember] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
              <span class="block mt-4 font-display text-sm text-[--color-smoke] group-hover:text-[--color-ember] transition-colors">VIEW ALL</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PANEL 5: COMMUNITY / TESTIMONIALS ==================== -->
  <section id="community" class="py-20 md:py-32 bg-[--color-ash-light] relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="font-display text-4xl md:text-6xl text-[--color-paper] mb-4">
          JOIN THE <span class="text-[--color-ember]">FAMILY</span>
        </h2>
        <p class="text-[--color-smoke-light] text-lg">What our community says about us</p>
      </div>
      
      <!-- Testimonials in thought bubbles -->
      <div class="grid md:grid-cols-3 gap-8">
        <div class="testimonial" data-animate>
          <div class="thought-bubble-large p-6">
            <p class="text-[--color-ash] font-comic text-lg mb-4">
              "I love this store! Been coming here since they opened. Best selection on Long Island!"
            </p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-[--color-ember] flex items-center justify-center text-white font-display">B</div>
              <div>
                <p class="font-display text-sm text-[--color-ash]">Ben P.</p>
                <p class="text-xs text-[--color-smoke]">Loyal Customer</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="testimonial" data-animate style="animation-delay: 0.1s;">
          <div class="thought-bubble-large p-6">
            <p class="text-[--color-ash] font-comic text-lg mb-4">
              "Peter knows his stuff! Always has great recommendations for indie titles."
            </p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-[--color-flame] flex items-center justify-center text-[--color-ash] font-display">J</div>
              <div>
                <p class="font-display text-sm text-[--color-ash]">Jordan</p>
                <p class="text-xs text-[--color-smoke]">Collector</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="testimonial" data-animate style="animation-delay: 0.2s;">
          <div class="thought-bubble-large p-6">
            <p class="text-[--color-ash] font-comic text-lg mb-4">
              "Friendly atmosphere and amazing collection. This is what a comic shop should be!"
            </p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-[--color-heat] flex items-center justify-center text-white font-display">M</div>
              <div>
                <p class="font-display text-sm text-[--color-ash]">Mike R.</p>
                <p class="text-xs text-[--color-smoke]">Manga Fan</p>
              </div>
